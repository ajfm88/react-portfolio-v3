# --- Server ---
PORT=3000
NODE_ENV=production

# Comma-separated allowed origins: the SPA in dev + your Vercel domain in prod.
# e.g. CLIENT_URL=http://localhost:5173,https://ajfm88.com
CLIENT_URL=http://localhost:5173

# --- MongoDB Atlas ---
# Include the database name between the host and the query string. Atlas hands you
# a string without one, and with that segment empty the driver silently connects
# to a database called `test` instead of failing.
# e.g. MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/3dfolio?appName=Cluster0
MONGO_URI=

# --- Clerk (shared auth for /blog + /chat) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- ImageKit (blog cover signing + chat media uploads) ---
# Only the private key is read here: it signs the blog's direct-upload params and
# uploads chat media. The endpoint and public key are the browser's half of the
# same account and are set on the frontend as VITE_IK_*; they are listed here so
# both halves of the account stay documented in one place.
IK_URL_ENDPOINT=
IK_PUBLIC_KEY=
IK_PRIVATE_KEY=
